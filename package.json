{
  "name": "abcm-mcp-server",
  "version": "0.1.0",
  "description": "MCP and REST server library for Agent Build Context Manager workspaces",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-context",
    "context-management"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && bun test",
    "dev:rest": "bun run src/cli/rest-server.ts",
    "dev:mcp": "bun run src/cli/mcp-stdio.ts",
    "openapi:generate": "bun run src/cli/generate-openapi.ts .abcm-generated/openapi-v1.json",
    "bench": "bun run benchmarks/large-fixture.ts",
    "benchmark:context-efficiency": "bun run benchmarks/context-efficiency.ts",
    "benchmark:context-efficiency:docker": "bun run scripts/run-context-efficiency-docker.ts",
    "benchmark:link-graph:docker": "bun run scripts/run-context-efficiency-docker.ts",
    "sbom:generate": "bun run scripts/generate-sbom.ts",
    "documentation:export": "bun run scripts/export-abcm-documentation.ts",
    "documentation:sync-contracts": "bun run scripts/sync-abcm-contracts.ts",
    "runtime:inspect": "bun run scripts/inspect-mcp-runtime.ts",
    "documentation:check": "bun run documentation:export && bun run openapi:generate && bun run sbom:generate && bun run scripts/check-documentation.ts",
    "traceability:check": "bun run scripts/check-traceability.ts .abcm-documentation",
    "release:check": "bun x tsc -p tsconfig.release.json && bun run sbom:generate && bun run scripts/check-release.ts",
    "release:check:full": "bun run release:check && bun run documentation:check",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "latest",
    "typescript": "^6.0.0"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
